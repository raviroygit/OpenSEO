{
  "name": "openseo",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Open-source, self-hostable SEO & GEO auditing platform.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raviroygit/OpenSEO.git"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:worker": "tsc -p tsconfig.worker.json",
    "worker": "node dist/worker/index.js",
    "worker:dev": "node --watch --experimental-strip-types src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "bullmq": "6.3.2",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  }
}
