# ---------------------------------------------------------------------------
# OpenSEO — environment configuration
#
# Local dev:  copy to `.env` and adjust.
# Coolify:    paste these into the application's Environment Variables tab.
#             Never commit a real .env — it is gitignored and dockerignored.
# ---------------------------------------------------------------------------

# --- Required: external datastores ------------------------------------------
# OpenSEO does not ship a database. Point these at your own Postgres and Redis
# servers (managed service, separate host, or another Coolify resource).

# Postgres connection string.
# Managed providers usually require TLS — append ?sslmode=require if so.
DATABASE_URL=postgres://user:password@db.example.com:5432/openseo?sslmode=require

# Redis connection string, used for the BullMQ job queue.
# Use rediss:// (two s) for a TLS-enabled Redis endpoint.
REDIS_URL=redis://:password@redis.example.com:6379

# If you instead use the bundled overlay (docker-compose.bundled.yml), the
# hostnames are the compose service names:
#   DATABASE_URL=postgres://openseo:change-me@postgres:5432/openseo
#   REDIS_URL=redis://redis:6379


# --- Application -------------------------------------------------------------

# Public URL of this instance. Set to your own domain when self-hosting.
APP_URL=https://openseo.nxtgenaidev.com
NEXT_PUBLIC_APP_URL=https://openseo.nxtgenaidev.com

# Comma-separated origins allowed to invoke Server Actions. Must include the
# domain above, otherwise form submissions are rejected behind the proxy.
ALLOWED_ORIGINS=openseo.nxtgenaidev.com

NODE_ENV=production
PORT=3000


# --- Login gate (optional) ---------------------------------------------------
# Put the whole instance behind an auth server that speaks the nginx
# auth_request protocol (Authelia: /api/authz/auth-request). Visitors who are
# not signed in are sent to AUTH_LOGIN_URL. Leave AUTH_REQUEST_URL empty to
# run without a gate (local dev, or protection done elsewhere).
# AUTH_REQUEST_URL=https://auth.example.com/api/authz/auth-request
# AUTH_LOGIN_URL=https://auth.example.com/


# --- Alerts (optional) -------------------------------------------------------
# Scheduled audits email a project's alert address when a score drops 5+
# points or a new critical issue appears. Without SMTP_HOST they are logged.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASS=
# SMTP_FROM=OpenSEO <alerts@example.com>


# --- Worker ------------------------------------------------------------------

# Name of the BullMQ queue. Web and worker must agree on this value.
# Cannot contain ':' — BullMQ reserves it as the Redis key separator.
QUEUE_NAME=openseo-audits

# Jobs processed concurrently per worker container.
WORKER_CONCURRENCY=4

# Max Postgres connections held per process. Keep the total across all app and
# worker containers below your database's connection limit.
DATABASE_POOL_MAX=10

# How long to wait for a Postgres connection before giving up, in milliseconds.
DATABASE_CONNECT_TIMEOUT_MS=5000


# --- Bundled overlay only ----------------------------------------------------
# Needed ONLY when running docker-compose.bundled.yml. Ignore these if you use
# your own database servers.
# POSTGRES_USER=openseo
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=openseo
